default_platform(:ios)

platform :ios do
  desc "يبني أرشيفًا موقَّعًا يدويًا (Manual Signing) ويرفعه إلى TestFlight عبر App Store Connect API Key"
  lane :beta do
    bundle_id = ENV.fetch("APP_BUNDLE_IDENTIFIER")
    profile_name = ENV.fetch("PROVISIONING_PROFILE_NAME")
    team_id = ENV.fetch("TEAM_ID")

    # مصادقة عبر App Store Connect API Key (JWT) — لا Apple ID ولا كلمة مرور ولا 2FA، مناسبة للـ CI headless.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_FILEPATH"),
      in_house: false
    )

    build_app(
      project: "PoetryMeterApp.xcodeproj",
      scheme: "PoetryMeterApp",
      configuration: "Beta",
      export_method: "app-store",
      xcargs: [
        "PRODUCT_BUNDLE_IDENTIFIER=#{bundle_id}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=Apple Distribution",
        "PROVISIONING_PROFILE_SPECIFIER=#{profile_name}",
        "DEVELOPMENT_TEAM=#{team_id}"
      ].join(" "),
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          bundle_id => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
